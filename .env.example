# --- Required ---
# Postgres connection string (Vercel → Storage → Neon gives you this automatically)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Long random string used to sign staff login cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# First admin account (created automatically on first run)
ADMIN_EMAIL=owner@mugnatattoo.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Image uploads (Vercel → Storage → Blob gives you this automatically) ---
BLOB_READ_WRITE_TOKEN=

# --- Optional: automatic GCash checkout through PayMongo ---
# Without these, customers pay by scanning your GCash QR and uploading the receipt.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Public URL of the site (optional, used for payment redirects)
SITE_URL=https://mugna-tattoo.vercel.app
